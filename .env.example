# Copy this file to .env and fill in real values. Never commit .env.

# ---- Your live domain (production only) ----
# Needed by docker-compose.prod.yml, which puts Caddy in front of the site
# and gets a free HTTPS certificate for this domain automatically.
# Leave empty for local use.
SITE_DOMAIN=

# ---- Ports on your machine (change these if something else is already using them) ----
# Both are published on 127.0.0.1 only, so on a server nothing is reachable
# from the internet except through Caddy. Postgres is not published at all.
FRONTEND_PORT=8090
BACKEND_PORT=8000

# ---- Security ----
# Swagger/ReDoc publish a complete map of the API. Leave false in public.
ENABLE_API_DOCS=false
# Registration/login endpoints. Nothing in the storefront uses them, so they
# stay unmounted; set true only if you add customer accounts later.
ENABLE_ACCOUNTS=false
# Scales the per-IP limits on checkout and the account routes. Browsing and
# cart traffic are never limited. 0 disables limiting entirely.
RATE_LIMIT_PER_MINUTE=60

# ---- PostgreSQL ----
POSTGRES_USER=meravo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meravo

# ---- Backend ----
DATABASE_URL=postgresql+asyncpg://meravo:change-me@db:5432/meravo
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8090,http://127.0.0.1:8090

# ---- Stitch (card and Pay by Bank) ----
# From Meravo's Stitch account (https://stitch.money). Card details are typed
# into Stitch's own page and never reach this app; payments settle to the
# bank account Stitch holds for the business. Until both of the first two
# are set, checkout says card payments open soon and offers WhatsApp.
# A client id starting "test-" is a Stitch test client: no real money moves.
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
# Signing secret (whsec_...) of the webhook you add at Stitch for the
# "payment" event, pointing at https://<your domain>/api/payments/stitch/webhook
STITCH_WEBHOOK_SECRET=
# Only if Stitch asks you to name the settlement account on every payment:
STITCH_BENEFICIARY_NAME=
STITCH_BENEFICIARY_BANK_ID=
STITCH_BENEFICIARY_ACCOUNT_NUMBER=

# ---- Frontend ----
# Relative path: nginx (frontend container) proxies /api to the backend
# container, so the browser only ever talks to one origin.
VITE_API_BASE_URL=/api

# ---- Order notification email ----
# When an order is PAID, MERAVO emails the shop owner and the customer.
# Leave SMTP_HOST empty to switch sending off entirely (nothing else breaks).
#
# For a Gmail address you must use an "App password", NOT your normal Gmail
# password: turn on 2-Step Verification at https://myaccount.google.com/security
# then create one at https://myaccount.google.com/apppasswords and paste the
# 16 characters below (spaces are fine).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=Heinrichcdoman@gmail.com
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Who the mail appears to come from. Leave MAIL_FROM empty to use SMTP_USERNAME.
MAIL_FROM=
MAIL_FROM_NAME=MERAVO

# Where the "you have a new order" email goes, and the contact details shown
# in both emails.
SHOP_OWNER_EMAIL=Heinrichcdoman@gmail.com
SHOP_CONTACT_PHONE=067 157 2670
STORE_URL=http://localhost:8090

# ---- WhatsApp order confirmation ----
# Sent to the customer when their payment is confirmed. Leave
# WHATSAPP_PROVIDER empty to switch it off. Options: meta | twilio
#
# IMPORTANT: WhatsApp does not let a business send free-form messages to
# someone who has not messaged it first. An order confirmation must use a
# message TEMPLATE approved in advance - see the README for the exact
# wording to submit and the four values it is sent.
WHATSAPP_PROVIDER=
# What a leading 0 on a typed number is replaced with. 27 = South Africa.
WHATSAPP_COUNTRY_CODE=27

# --- if WHATSAPP_PROVIDER=meta (WhatsApp Cloud API, direct from Meta) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=order_confirmation
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- if WHATSAPP_PROVIDER=twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Twilio's approved template id. Leave empty to send plain text, which
# only works inside the Twilio sandbox.
TWILIO_CONTENT_SID=
