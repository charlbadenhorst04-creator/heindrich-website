# Copy this file to .env and fill in real values. Never commit .env.

# ---- Ports on your machine (change these if something else is already using them) ----
# Postgres is deliberately not published to the host - see docker-compose.yml.
FRONTEND_PORT=8090
BACKEND_PORT=8000

# ---- PostgreSQL ----
POSTGRES_USER=meravo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meravo

# ---- Backend ----
DATABASE_URL=postgresql+asyncpg://meravo:change-me@db:5432/meravo
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8090,http://127.0.0.1:8090

# ---- Payfast (South African payment gateway) ----
# Get these from your own Payfast merchant account (https://www.payfast.co.za).
# Your payouts settle to whatever South African bank account you link there
# (e.g. your Capitec account) - card/account numbers never live in this app.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=
PAYFAST_RETURN_URL=http://localhost:8090/order-success
PAYFAST_CANCEL_URL=http://localhost:8090/cart
PAYFAST_NOTIFY_URL=http://localhost:8000/api/payments/payfast/notify

# ---- Frontend ----
# Relative path: nginx (frontend container) proxies /api to the backend
# container, so the browser only ever talks to one origin.
VITE_API_BASE_URL=/api

# ---- Order notification email ----
# When an order is PAID, MERAVO emails the shop owner and the customer.
# Leave SMTP_HOST empty to switch sending off entirely (nothing else breaks).
#
# For a Gmail address you must use an "App password", NOT your normal Gmail
# password: turn on 2-Step Verification at https://myaccount.google.com/security
# then create one at https://myaccount.google.com/apppasswords and paste the
# 16 characters below (spaces are fine).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=Heinrichcdoman@gmail.com
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Who the mail appears to come from. Leave MAIL_FROM empty to use SMTP_USERNAME.
MAIL_FROM=
MAIL_FROM_NAME=MERAVO

# Where the "you have a new order" email goes, and the contact details shown
# in both emails.
SHOP_OWNER_EMAIL=Heinrichcdoman@gmail.com
SHOP_CONTACT_PHONE=067 157 2670
STORE_URL=http://localhost:8090
