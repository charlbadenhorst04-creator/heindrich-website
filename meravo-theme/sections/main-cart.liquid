{%- comment -%}
  The cart, using Shopify's own cart and checkout.

  The +, - and remove controls are links to /cart/change, so they work on
  their own. theme.js turns them into Cart AJAX API calls and redraws this
  section in place through the Section Rendering API.

  Shipping is worked out by Shopify at checkout from Settings > Shipping
  and delivery. The note under the subtotal is only words; keep it in step
  with those rates.
{%- endcomment -%}
<div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8" data-cart data-section-id="{{ section.id }}">
  <h1 class="font-display text-3xl text-maroon-800">{{ 'cart.general.title' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <div class="mt-16 text-center">
      <p class="text-maroon-900/50">{{ 'cart.general.empty' | t }}</p>
      <a
        href="{{ routes.all_products_collection_url }}"
        class="mt-6 inline-block rounded-full bg-maroon-700 px-8 py-3 text-sm font-semibold text-white hover:bg-maroon-800"
      >
        {{- 'general.continue_shopping' | t -}}
      </a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate class="mt-8 grid grid-cols-1 gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        {%- for item in cart.items -%}
          {%- liquid
            assign line = forloop.index
            assign at_max = false
            if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'deny' and item.quantity >= item.variant.inventory_quantity
              assign at_max = true
            endif
            assign minus_quantity = item.quantity | minus: 1
            assign plus_quantity = item.quantity | plus: 1
          -%}
          <div
            class="fade-up mb-4 flex items-center gap-4 rounded-2xl bg-white p-4 ring-1 ring-maroon-100"
            style="--fade-y: 10px; --fade-duration: 0.3s;"
            data-cart-line
          >
            <a href="{{ item.url }}" class="shrink-0">
              {%- if item.image -%}
                {{
                  item.image
                  | image_url: width: 160, height: 160, crop: 'center'
                  | image_tag: class: 'h-20 w-20 rounded-xl object-cover', loading: 'lazy', alt: item.product.title
                }}
              {%- else -%}
                <div class="h-20 w-20 overflow-hidden rounded-xl">{% render 'image-placeholder' %}</div>
              {%- endif -%}
            </a>

            <div class="min-w-0 flex-1">
              <a href="{{ item.url }}" class="font-medium text-maroon-900 hover:underline">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p class="text-xs text-maroon-900/50">{{ item.variant.title }}</p>
              {%- endunless -%}
              <p class="text-sm text-maroon-900/50">
                {%- if item.original_price != item.final_price -%}
                  <s class="mr-1">{{ item.original_price | money }}</s>
                {%- endif -%}
                {{ item.final_price | money }}
              </p>
              {%- for discount in item.line_level_discount_allocations -%}
                <p class="text-xs text-gold-600">{{ discount.discount_application.title }} (-{{ discount.amount | money }})</p>
              {%- endfor -%}
            </div>

            <div class="flex items-center rounded-full border border-maroon-200">
              {%- if item.quantity > 1 -%}
                <a
                  href="{{ routes.cart_change_url }}?line={{ line }}&amp;quantity={{ minus_quantity }}"
                  class="px-3 py-1 text-maroon-700"
                  data-line-change
                  data-line="{{ line }}"
                  data-quantity="{{ minus_quantity }}"
                  aria-label="{{ 'cart.general.decrease' | t: title: item.product.title | escape }}"
                  >-</a
                >
              {%- else -%}
                <span class="px-3 py-1 text-maroon-700 opacity-40" aria-hidden="true">-</span>
              {%- endif -%}
              <span class="w-6 text-center text-sm">{{ item.quantity }}</span>
              {%- if at_max -%}
                <span class="px-3 py-1 text-maroon-700 opacity-40" aria-hidden="true">+</span>
              {%- else -%}
                <a
                  href="{{ routes.cart_change_url }}?line={{ line }}&amp;quantity={{ plus_quantity }}"
                  class="px-3 py-1 text-maroon-700"
                  data-line-change
                  data-line="{{ line }}"
                  data-quantity="{{ plus_quantity }}"
                  aria-label="{{ 'cart.general.increase' | t: title: item.product.title | escape }}"
                  >+</a
                >
              {%- endif -%}
            </div>

            <p class="hidden w-24 text-right font-medium text-maroon-800 sm:block">{{ item.final_line_price | money }}</p>

            <a
              href="{{ item.url_to_remove }}"
              class="text-maroon-900/40 hover:text-maroon-700"
              data-line-change
              data-line="{{ line }}"
              data-quantity="0"
              aria-label="{{ 'cart.general.remove' | t: title: item.product.title | escape }}"
            >
              {%- render 'icon', name: 'close', class: 'h-5 w-5', stroke_width: 1.7 -%}
            </a>
          </div>
        {%- endfor -%}
      </div>

      <div
        class="fade-up h-fit rounded-2xl bg-white p-6 ring-1 ring-maroon-100"
        style="--fade-y: 10px; --fade-duration: 0.3s;"
      >
        <h2 class="font-display text-xl text-maroon-800">{{ 'cart.general.summary' | t }}</h2>
        <div class="mt-4 flex justify-between text-sm text-maroon-900/70">
          <span>{{ 'cart.general.subtotal' | t }}</span>
          <span>{{ cart.items_subtotal_price | money }}</span>
        </div>
        {%- for discount in cart.cart_level_discount_applications -%}
          <div class="mt-2 flex justify-between text-sm text-gold-600">
            <span>{{ discount.title }}</span>
            <span>-{{ discount.total_allocated_amount | money }}</span>
          </div>
        {%- endfor -%}
        <div class="mt-2 flex justify-between gap-4 text-sm text-maroon-900/70">
          <span class="whitespace-nowrap">{{ 'cart.general.shipping' | t: courier: section.settings.courier }}</span>
          <span class="text-right">{{ 'cart.general.shipping_at_checkout' | t }}</span>
        </div>
        {%- liquid
          assign threshold = section.settings.free_shipping_threshold | times: 100
          assign threshold_money = threshold | money
          assign total_money = cart.total_price | money
        -%}
        {%- if threshold > 0 and cart.total_price < threshold -%}
          <p class="mt-1 text-xs text-maroon-900/40">
            {{- 'cart.general.free_shipping_over' | t: amount: threshold_money -}}
          </p>
        {%- endif -%}
        <div class="mt-4 flex justify-between border-t border-maroon-100 pt-4 font-display text-lg text-maroon-800">
          <span>{{ 'cart.general.total' | t }}</span>
          <span>{{ 'cart.general.total_plus_shipping' | t: total: total_money }}</span>
        </div>
        {%- if section.settings.delivery_note != blank -%}
          <p class="mt-2 flex items-center gap-1.5 text-xs text-maroon-900/50">
            {%- render 'icon', name: 'truck', class: 'h-3.5 w-3.5 shrink-0' -%}
            {{ section.settings.delivery_note }}
          </p>
        {%- endif -%}
        <button
          type="submit"
          name="checkout"
          class="mt-6 w-full rounded-full bg-maroon-700 py-3 text-sm font-semibold text-white hover:bg-maroon-800"
        >
          {{- 'cart.general.checkout' | t -}}
        </button>
        <p class="mt-3 text-center text-xs text-maroon-900/40">{{ 'cart.general.secure_note' | t }}</p>
      </div>
    </form>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "courier",
      "label": "Courier name",
      "default": "Aramex"
    },
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "Free shipping from (R)",
      "info": "Shows \"Free shipping on orders over ...\" below this amount. Set the same rule in Settings > Shipping and delivery. 0 hides it.",
      "default": 1500
    },
    {
      "type": "text",
      "id": "delivery_note",
      "label": "Delivery note",
      "default": "Delivered nationwide via Aramex, 2-4 business days"
    }
  ]
}
{% endschema %}
