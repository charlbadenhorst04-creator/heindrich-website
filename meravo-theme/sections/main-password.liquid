{%- comment -%} The "opening soon" page shown while the store has a password. {%- endcomment -%}
<div class="mx-auto flex min-h-[70vh] max-w-xl flex-col items-center justify-center px-4 py-16 text-center">
  {%- render 'logo-mark', class: 'h-14 w-14 text-maroon-700' -%}
  <img
    src="{{ 'meravo-wordmark.png' | asset_url }}"
    alt="{{ shop.name | escape }}"
    class="fade-up mt-4 h-14 w-auto"
    width="559"
    height="232"
    style="--fade-y: 10px;"
  >
  <h1 class="fade-up mt-8 font-display text-3xl text-maroon-800" style="--fade-y: 20px; --fade-delay: 0.1s;">
    {{ section.settings.heading }}
  </h1>
  {%- if shop.password_message != blank -%}
    <p class="fade-up mt-4 text-maroon-900/70" style="--fade-y: 20px; --fade-delay: 0.2s;">{{ shop.password_message }}</p>
  {%- endif -%}

  <details class="fade-up mt-10 w-full" style="--fade-y: 20px; --fade-delay: 0.3s;">
    <summary class="cursor-pointer text-sm font-medium text-maroon-700 hover:underline">{{ 'password.enter' | t }}</summary>
    {%- form 'storefront_password', class: 'mt-4 flex gap-3' -%}
      <label class="sr-only" for="Password">{{ 'password.label' | t }}</label>
      <input type="password" name="password" id="Password" autocomplete="current-password" class="input rounded-full" placeholder="{{ 'password.label' | t }}">
      <button type="submit" class="rounded-full bg-maroon-700 px-6 py-2 text-sm font-semibold text-white hover:bg-maroon-800">
        {{- 'password.submit' | t -}}
      </button>
      {%- if form.errors -%}
        <p class="mt-3 text-sm text-red-600" role="alert">{{ 'password.wrong' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </details>
</div>

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening soon"
    }
  ]
}
{% endschema %}
