{%- comment -%}
  "Popular Right Now": a collection as a swipeable row on phones that
  becomes a grid from tablet up. Shows every product in the chosen
  collection up to the limit; with no collection chosen, the newest
  products in the store.
{%- endcomment -%}
{%- liquid
  assign collection = section.settings.collection
  if collection == blank
    assign collection = collections.all
  endif
  assign limit = section.settings.products_to_show
-%}
<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
  <div class="mb-8" data-reveal style="--reveal-y: 12px;">
    {%- if section.settings.eyebrow != blank -%}
      <p class="text-sm font-semibold uppercase tracking-widest text-gold-600">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="mt-1 font-display text-3xl text-maroon-800">{{ section.settings.title }}</h2>
    {%- endif -%}
  </div>

  <div class="no-scrollbar flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4 md:grid md:grid-cols-3 md:gap-6 md:overflow-visible md:pb-0 lg:grid-cols-4">
    {%- if collection.products_count > 0 -%}
      {%- for product in collection.products limit: limit -%}
        {% render 'showcase-card', product: product, index: forloop.index0 %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        {% render 'placeholder-card', index: forloop.index0, style: 'showcase' %}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product showcase",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop the Range"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Popular Right Now"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to show the newest products."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Product showcase"
    }
  ]
}
{% endschema %}
